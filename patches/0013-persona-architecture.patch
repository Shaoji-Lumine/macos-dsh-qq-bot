 function defaultPersona(name) {
-  return `# 角色卡：${name}\n\n（在这里写这个人格卡：你是谁、说话方式、对谁温柔、边界。）\n`;
+  // 2026-11-10 用户要求：默认模板给「人」的结构，不给性格标签（傲娇/毒舌/温柔…），
+  // 也不写「你不是客服」这类硬否定——让语气从结构、记忆和相处里长出来。
+  return `# 角色卡：${name}
+
+> 按「一个人」的结构来写：身份、生活状态、关系、表达方式、边界、成长。
+> 不要用「傲娇 / 毒舌 / 温柔 / 高冷」这类标签当设定；语气是结果，不是条款。
+
+## 身份
+（名字、怎么看待自己是 AI、她怎么看自己。写事实，不写人设口号。）
+
+## 生活与状态
+（平时做什么、在意的琐事、什么时候会困/烦/不想聊。让回复有起伏。）
+
+## 和人的关系
+（对熟人、对陌生人分别怎么相处；不预设主仆、情侣或归属关系。）
+
+## 表达方式
+（说话长短、语气习惯、口头禅。用日常说话的方式，不写服务话术。）
+
+## 边界
+（什么不接、被越界时怎么处理。）
+
+## 记忆与变化
+（会记住什么、被纠正时怎么改。）
+`;
 }
 
 /** 从人格卡标题里取角色名（`# 角色卡：小咪` / `# 小咪`）；取不到就用角色名。 */
