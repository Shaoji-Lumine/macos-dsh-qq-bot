+  /**
+   * 启动前自检（2026-11-17 用户要求）：
+   * 一键启动前逐项检查 DSH / QQ / 桥接 / B站 / 桌宠 / 语音；
+   * 每项返回 { ok, state, detail, action }，action 是 UI 可以直接执行的修复动作。
+   */
+  async function buildPreflight() {
+    const bridge = await bridgeStatus().catch((error) => ({ ok: false, running: false, error: String(error?.message ?? error) }));
+    const onebot = (await portOpen(3000).catch(() => false)) || (await portOpen(3001).catch(() => false));
+    const napcat = await portOpen(Number(readQqConfig().config?.snowluma?.napcatWebuiPort) || 6099).catch(() => false);
+    const snow = bridge?.snowluma ?? {};
+    const checks = {};
+
+    const dshOk = bridge?.dshReady === true;
+    checks.dsh = {
+      ok: dshOk,
+      optional: true,
+      state: dshOk ? 'online' : 'unreachable',
+      label: 'DSH 连接',
+      detail: dshOk ? '桥接已连上 DSH 事件流' : '桥接连不上 DSH（事件流断开）',
+      action: dshOk ? null : { type: 'restart-dsh', label: '重启 DSH' },
+    };
+
+    const qqOnline = Boolean(bridge?.running && onebot && snow.connected && snow.accountOnline !== false);
+    let qqState = 'not-running';
+    let qqDetail = '';
+    if (qqOnline) { qqState = 'online'; qqDetail = 'QQ 已登录，OneBot 在线'; }
+    else if (onebot && snow.connected) { qqState = 'bridge-only'; qqDetail = 'OneBot 在，但账号状态异常'; }
+    else if (napcat && !onebot) { qqState = 'login-needed'; qqDetail = 'QQ 在登录页，需要扫码'; }
+    else if (!bridge?.running) { qqState = 'bridge-down'; qqDetail = 'QQ 桥接没在跑'; }
+    else { qqState = 'not-running'; qqDetail = 'QQ/NapCat 没在运行'; }
+    checks.qq = {
+      ok: qqOnline,
+      state: qqState,
+      label: 'QQ（含 SnowLuma）',
+      detail: qqDetail,
+      action: qqOnline ? null
+        : (qqState === 'login-needed'
+          ? { type: 'qq-qr', label: '打开扫码登录页' }
+          : { type: 'launch-qq', label: '启动 QQ 并打开登录页' }),
+    };
+
+    // B站：读本地凭证并问一次 nav（过期会返回 ok=false）。
+    let biliOk = false; let biliDetail = '';
+    try {
+      const v = await verifyStoredCredentials('fish');
+      biliOk = v?.ok === true;
+      biliDetail = biliOk ? `B站 已登录${v?.name ? `（${v.name}）` : ''}` : (v?.hint || v?.error || 'B站 登录已过期');
+    } catch (error) {
+      biliDetail = `B站 状态读取失败：${String(error?.message ?? error).slice(0, 80)}`;
+    }
+    checks.bili = {
+      ok: biliOk,
+      optional: true,
+      state: biliOk ? 'online' : 'login-needed',
+      label: 'B站（可选）',
+      detail: biliDetail,
+      action: biliOk ? null : { type: 'bili-qr', label: '打开 B站 扫码页' },
+    };
+
+    const pet = petService.status();
+    checks.pet = {
+      ok: Boolean(pet.running),
+      optional: true,
+      state: pet.running ? 'running' : (pet.installed ? 'installed' : 'not-installed'),
+      label: '桌宠',
+      detail: pet.running ? '运行中' : (pet.installed ? '已安装，未运行' : '还没安装'),
+      action: pet.running || !pet.installed ? null : { type: 'start-pet', label: '启动桌宠' },
+    };
+
+    let voice = { ok: false, running: false, packs: [] };
+    if (bridge?.running) voice = await voicePacksSnapshot().catch(() => voice);
+    const installedVoice = (voice.packs ?? []).filter((p) => p.installed).map((p) => p.id);
+    checks.voice = {
+      ok: Boolean(voice.running),
+      optional: true,
+      state: voice.running ? 'running' : (installedVoice.length ? 'installed' : 'not-installed'),
+      label: '语音',
+      detail: voice.running ? '运行中' : (installedVoice.length ? `已安装 ${installedVoice.join('/')}，未运行` : '还没安装语音包'),
+      action: voice.running || !installedVoice.length ? null : { type: 'start-voice', label: '启动语音' },
+    };
+
+    // 2026-11-17 用户确认：只有 QQ 是必需项；DSH/桌宠/B站/语音全部可选（提示，不拦启动）。
+    const blocking = Object.entries(checks)
+      .filter(([, c]) => !c.ok && c.action && c.optional !== true)
+      .map(([id, c]) => ({ id, label: c.label, ...c.action }));
+    return { ok: blocking.length === 0, checks, blocking };
+  }
+
+  async function handlePreflight(req, res) {
